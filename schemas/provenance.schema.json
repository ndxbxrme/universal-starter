{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "templateName",
    "templateVersion",
    "projectId",
    "initializedAppId",
    "appliedMigrations"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "templateName": { "type": "string", "minLength": 1 },
    "templateVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "projectId": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "initializedAppId": { "type": "string" },
    "appliedMigrations": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string" }
    }
  }
}
