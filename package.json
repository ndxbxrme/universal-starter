{
  "name": "universal-starter",
  "version": "0.1.0",
  "private": true,
  "description": "One vanilla SPA for web, mobile and desktop",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:web": "npm run dev",
    "build": "vite build --mode native",
    "build:web": "vite build --mode web",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm test && npm run test:e2e",
    "cap:sync": "node scripts/mobile.mjs sync",
    "cap:sync:android": "node scripts/mobile.mjs sync android",
    "cap:sync:ios": "node scripts/mobile.mjs sync ios",
    "build:android": "node scripts/mobile.mjs build-android",
    "build:android:release": "node scripts/mobile.mjs build-android --release",
    "android:pair": "node scripts/mobile.mjs pair",
    "android:devices": "node scripts/mobile.mjs devices",
    "android:install": "node scripts/mobile.mjs install",
    "android:logs": "node scripts/mobile.mjs logs",
    "android:open": "node scripts/mobile.mjs open-android",
    "dev:android": "node scripts/mobile.mjs live",
    "icons:generate": "node scripts/icons.mjs",
    "test:android": "node scripts/test-mobile.mjs android",
    "test:ios": "node scripts/test-mobile.mjs ios",
    "test:mobile": "node scripts/test-mobile.mjs all",
    "build:ios": "node scripts/mobile.mjs build-ios",
    "build:ios:release": "node scripts/mobile.mjs release-ios",
    "dev:ios": "node scripts/mobile.mjs dev-ios",
    "ios:open": "node scripts/mobile.mjs open-ios",
    "dev:desktop": "node scripts/desktop.mjs dev",
    "build:desktop": "node scripts/desktop.mjs build",
    "build:desktop:win": "node scripts/desktop.mjs win",
    "build:desktop:mac": "node scripts/desktop.mjs mac",
    "build:desktop:linux": "node scripts/desktop.mjs linux",
    "test:desktop": "npm run build && node tests/electron/smoke.mjs",
    "security:audit": "npm audit --audit-level=moderate",
    "verify:repository": "node scripts/verify-repository.mjs",
    "artifacts": "node scripts/artifacts.mjs",
    "credentials:status": "node scripts/credentials/status.mjs",
    "release:prepare": "node scripts/release.mjs prepare",
    "release": "node scripts/release.mjs entry",
    "config:validate": "node scripts/config.mjs validate",
    "config:sync": "node scripts/config.mjs sync",
    "identity:plan": "node scripts/identity-plan.mjs",
    "doctor": "node scripts/doctor.mjs",
    "deps:check": "node scripts/dependencies.mjs check",
    "deps:update": "node scripts/dependencies.mjs update",
    "credentials:setup:android": "node scripts/credentials/setup.mjs android",
    "credentials:setup:ios": "node scripts/credentials/setup.mjs ios",
    "credentials:setup:windows": "node scripts/credentials/setup.mjs windows",
    "credentials:setup:macos": "node scripts/credentials/setup.mjs macos",
    "credentials:github:plan": "node scripts/credentials/github.mjs plan",
    "credentials:github:sync": "node scripts/credentials/github.mjs sync",
    "setup": "node scripts/setup.mjs",
    "licenses:generate": "node scripts/notices.mjs",
    "test:release-guard": "node scripts/test-release-guard.mjs",
    "verify:native": "node scripts/check-native.mjs",
    "verify:docs": "node scripts/verify-docs.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@capacitor/cli": "8.5.3",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "ajv": "8.20.0",
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "sharp": "0.35.5",
    "vite": "8.3.5",
    "vitest": "5.1.0",
    "yaml": "2.9.1"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.5",
    "@capacitor/camera": "8.2.6",
    "@capacitor/clipboard": "8.0.1",
    "@capacitor/core": "8.5.3",
    "@capacitor/device": "8.0.3",
    "@capacitor/geolocation": "8.2.4",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.5.3",
    "@capacitor/local-notifications": "8.3.1",
    "@capacitor/network": "8.0.1",
    "@capacitor/screen-orientation": "8.0.2",
    "@capacitor/share": "8.0.3"
  },
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    }
  },
  "main": "electron/main.cjs",
  "author": "Universal Starter contributors",
  "homepage": "https://example.com",
  "desktopName": "dev.example.universalstarter.desktop"
}
